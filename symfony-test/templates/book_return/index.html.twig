{% extends 'base.html.twig' %}

{% block title %}BookReturn index{% endblock %}

{% block body %}
    <h1>BookReturn index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>ReturnDate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for book_return in book_returns %}
            <tr>
                <td>{{ book_return.id }}</td>
                <td>{{ book_return.returnDate ? book_return.returnDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_book_return_show', {'id': book_return.id}) }}">show</a>
                    <a href="{{ path('app_book_return_edit', {'id': book_return.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_book_return_new') }}">Create new</a>
{% endblock %}
